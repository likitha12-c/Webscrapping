                                  <field>[federated.0lpdzz90kz92x613xvd5e09zfnax].[none:Rating_Category:nk]</field>
                                </columns>
                              </tuple-descriptor>
                              <tuple>
                                <value>203</value>
                                <value>&quot;Average&quot;</value>
                              </tuple>
                            </tuple-reference>
                          </tuple-selection>
                        </selection-collection>
                      </worksheet>
                    </currentDeltas>
                    <capturedDeltas />
                  </story-point>
                </story-points>
