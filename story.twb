              <flipboard active-id='1' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='Ratings are spread almost evenly from 1 to 5 stars, and price has almost no relationship with rating (correlation 0.03). Of the 226 one-star products, 89 cost $40 or more, while 42 five-star products cost under $20, so paying more does not guarantee a better-rated product. Brand data is not available in the source, so price segments are used as a stand-in.' captured-sheet='Dashboard 2' id='1' />
                </story-points>
              </flipboard>
            </zone>
          </zone>
