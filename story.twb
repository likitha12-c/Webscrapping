              <flipboard active-id='1' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='Premium and Mid-Range products dominate the catalogue, with 403 and 401 of 1,000 products. Premium products have the highest average price ($49.91) and the highest average rating (2.98), but ratings are nearly the same in every price segment (2.85 to 2.98), so higher prices do not mean better-rated products. Price segments stand in for categories because the source data has no product category.' captured-sheet='Dashboard 1' id='1' />
                </story-points>
              </flipboard>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
